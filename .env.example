# Pudim Lapanini — variáveis de ambiente (MODELO SEGURO — sem senhas reais)
# Como usar: copie para o ambiente e preencha no cPanel.
# O projeto lê a configuração via app/config.php (auto-detect localhost/produção).
# NÃO commite arquivos com senhas reais. NÃO suba .env com segredos para public_html.

# --- Banco de dados (produção: criar no cPanel > MySQL Databases) ---
DB_HOST=localhost
DB_NAME=seu_banco_aqui
DB_USER=seu_usuario_aqui
DB_PASS=troque-por-senha-forte-aqui

# --- Ambiente ---
# dev  = localhost/http  (cookie sem Secure)
# prod = HostGator/https (cookie Secure)
APP_ENV=prod

# --- Cloudflare Turnstile (opcional; vazio = proteção desligada) ---
TURNSTILE_SECRET_KEY=
