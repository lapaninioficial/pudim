# Pudim Lapanini — raiz (HostGator Plano M, Apache + cPanel)
# MIME + cache longo para estáticos (CSS/JS usam ?v= cache-busting).
Options -Indexes

# Produção: força HTTPS + www SOMENTE no domínio oficial
# (localhost, homolog e outros domínios não são afetados).
# Provisório HostGator (plano M): força HTTPS sem www em agencia.staffecommerce.com.br.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^agencia\.staffecommerce\.com\.br$ [NC]
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
  RewriteCond %{HTTP_HOST} ^pudim\.lapanini\.com\.br$ [NC]
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
  RewriteCond %{HTTP_HOST} ^lapanini\.com\.br$ [NC]
  RewriteRule ^ https://www.lapanini.com.br%{REQUEST_URI} [R=301,L]
  RewriteCond %{HTTP_HOST} ^www\.lapanini\.com\.br$ [NC]
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# URLs antigas (cardápio anterior, caso indexadas): caem na home.
<IfModule mod_alias.c>
  RedirectMatch 301 (?i)^/lasanha.* /
</IfModule>

# Compressão de texto (ganho direto no 4G).
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Nunca expor segredos, dumps ou controle de versão.
<IfModule mod_authz_core.c>
  <FilesMatch "(\.(sql|env|log)|^\.git)">
    Require all denied
  </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
  <FilesMatch "(\.(sql|env|log)|^\.git)">
    Order allow,deny
    Deny from all
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(webp|png|jpe?g|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
